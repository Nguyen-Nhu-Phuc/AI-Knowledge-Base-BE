NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
APP_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://akb:akb_dev_password@localhost:5432/ai_knowledge_base?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REFRESH_COOKIE_NAME=akb_refresh_token
REFRESH_COOKIE_SECURE=false
# Use lax with same-origin web proxy (NEXT_PUBLIC_API_URL=/api/v1).
# For cross-origin web→API, set none + REFRESH_COOKIE_SECURE=true.
REFRESH_COOKIE_SAME_SITE=lax

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Super Admin emails (isPlatformAdmin): full system console at /app/super-admin
# Approve org-create requests; their own creates auto-approve
PLATFORM_ADMIN_EMAILS=demo@akb.local


# Server/Docker-internal MinIO host (worker/API download)
S3_ENDPOINT=http://localhost:9000
# Browser-facing host used to SIGN presigned upload URLs
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=akbminio
S3_SECRET_KEY=akbminio_dev_password
S3_BUCKET=ai-knowledge-base
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
MAX_UPLOAD_BYTES=52428800

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=dev-ai-service-secret
# Optional defaults forwarded to AI service (overrideable per org in Settings)
AI_EMBEDDING_PROVIDER=
AI_LLM_PROVIDER=

CHAT_TOP_K=8
ENABLE_QUERY_REWRITE=false
MAX_CONTEXT_TOKENS=3000
